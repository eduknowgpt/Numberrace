    private void showList() {
        clearErrors();
        formVisible = false;
        editingStudent = null;
        titleLabel.setText(Messages.getString("LangVars.REG_SELECTASTUDENT"));
        cardLayout.show(cards, CARD_LIST);
        updateSelectionInfo();
        studentList.requestFocusInWindow();
    }

    /** @param student aluno a editar, ou null para cadastrar um novo. */
    private void openForm(Student student) {
        clearErrors();
        formVisible = true;
        editingStudent = student;

        if (student == null) {
            titleLabel.setText(Messages.getString("LangVars.REG_NEWSTUDENT"));
            textFieldLastName.setText("");
            textFieldFirstName.setText("");
            textFieldClass.setText("");
            cbAge.setSelectedIndex(-1);
            cbGender.setSelectedIndex(-1);
            cbStartLevel.setSelectedIndex(-1);
            cbStartLevel.setEnabled(true);
            deleteButton.setVisible(false);
        } else {
            titleLabel.setText(Messages.getString("LangVars.REG_MODIFY"));
            textFieldLastName.setText(student.getLastName());
            textFieldFirstName.setText(student.getFirstName());
            textFieldClass.setText(student.getClassLevel());
            selectAge(student.getAge());
            cbGender.setSelectedIndex(student.getSex());
            cbStartLevel.setSelectedItem(student.getStartLevel());
            // o nível inicial não pode mais ser alterado depois do cadastro
            cbStartLevel.setEnabled(false);
            deleteButton.setVisible(true);
        }

        cardLayout.show(cards, CARD_FORM);
        textFieldLastName.requestFocusInWindow();
    }

    private void selectAge(int age) {
        Integer value = Integer.valueOf(age);
        boolean found = false;
        for (int i = 0; i < cbAge.getItemCount(); i++) {
            if (value.equals(cbAge.getItemAt(i))) {
                found = true;
                break;
            }
        }
        if (!found) {
            cbAge.addItem(value); // idade fora da faixa padrão (dados antigos)
        }
        cbAge.setSelectedItem(value);
    }

    // ==================================================================
    // Ações
    // ==================================================================
    public void actionPerformed(ActionEvent e) {
        Object actor = e.getSource();
        if (actor == quitButton) {
            GameObject.getInstance().changeState(GameStates.END);
        } else if (actor == startButton) {
            startSelected();
        } else if (actor == newStudentButton) {
            openForm(null);
        } else if (actor == modifyButton) {
            Student s = (Student) studentList.getSelectedValue();
            if (s != null) {
                openForm(s);
            } else {
                showMessage("LangVars.REG_NEEDTOSELECTTOMODIFY");
            }
        } else if (actor == confirmButton) {
            confirm();
        } else if (actor == cancelButton) {
            showList();
        } else if (actor == deleteButton) {
            confirmDelete();
        }
    }

    public void valueChanged(ListSelectionEvent e) {
        if (!e.getValueIsAdjusting()) {
            updateSelectionInfo();
        }
    }

    private void updateSelectionInfo() {
        Student s = (Student) studentList.getSelectedValue();
        boolean has = (s != null);
        startButton.setEnabled(has);
        modifyButton.setEnabled(has);
        if (has) {
            String name = s.getFirstName() + " " + s.getLastName();
            infoNameLabel.setText(name);
            infoNameLabel.setToolTipText(name);
            sessionsPlayedLabel.setText(Messages.getString("LangVars.REG_LASTSESSION")
                    + s.getSessionNumber());
        } else {
            infoNameLabel.setText(" ");
            infoNameLabel.setToolTipText(null);
            sessionsPlayedLabel.setText(" ");
        }
    }

    private void startSelected() {
        Student s = (Student) studentList.getSelectedValue();
        if (s == null) {
            showMessage("LangVars.REG_NEEDTOSELECTTOSTART");
            return;
        }
        GameObject.getInstance().setStudent(s);
        GameObject.getInstance().changeState(GameStates.THEME);
    }

    private void confirm() {
        clearErrors();

        String lastName = textFieldLastName.getText().trim();
        String firstName = textFieldFirstName.getText().trim();
        String classLevel = textFieldClass.getText().trim();
        boolean isNew = (editingStudent == null);

        boolean missing = false;
        if (lastName.length() == 0) {
            markError(lastNameLabel, textFieldLastName);
            missing = true;
        }
        if (firstName.length() == 0) {
            markError(firstNameLabel, textFieldFirstName);
            missing = true;
        }
        if (cbAge.getSelectedItem() == null) {
            markError(ageLabel, cbAge);
            missing = true;
        }
        if (classLevel.length() == 0) {
            markError(classLabel, textFieldClass);
            missing = true;
        }
        if (cbGender.getSelectedIndex() == -1) {
            markError(sexLabel, cbGender);
            missing = true;
        }
        if (isNew && cbStartLevel.getSelectedIndex() == -1) {
            markError(startLevelLabel, cbStartLevel);
            missing = true;
        }
        if (missing) {
            showStatus("LangVars.REG_NEEDTOENTERALLINFO");
            return;
        }

        if (isDuplicate(lastName, firstName)) {
            markError(lastNameLabel, textFieldLastName);
            markError(firstNameLabel, textFieldFirstName);
            showStatus("LangVars.REG_STUDENTALREADYEXISTS");
            return;
        }

        int age = ((Integer) cbAge.getSelectedItem()).intValue();
        Student saved;
        if (isNew) {
            // cópias independentes: antes as duas linhas apontavam para o mesmo array
            boolean[][] characAccess = { DEFAULT_ACCESS_PARAMS.clone(),
                    DEFAULT_ACCESS_PARAMS.clone() };
            // TODO: id = size()+1 pode repetir depois de uma exclusão;
            // preferir (maior id existente) + 1 se Student expuser getId().
            saved = new Student(
                    studentListData.size() + 1,
                    lastName,
                    firstName,
                    age,
                    classLevel,
                    cbGender.getSelectedIndex(),
                    cbStartLevel.getSelectedItem().toString(),
                    0,
                    0,
                    0,
                    characAccess,
                    new byte[ThemeVariables.NUMBER_OF_THEMES][Constants.NUMBER_POSS_REWARDS]);
            studentListData.add(saved);
        } else {
            saved = editingStudent;
            saved.setLastName(lastName);
            saved.setfirstName(firstName);
            saved.setAge(age);
            saved.setClassLevel(classLevel);
            saved.setSex(cbGender.getSelectedIndex());
        }

        saveStudents();
        studentList.setListData(studentListData);
        showList();
        studentList.setSelectedValue(saved, true);
    }

    /** Compara sem diferenciar maiúsculas e ignora o próprio aluno em edição. */
    private boolean isDuplicate(String lastName, String firstName) {
        for (Student s : studentListData) {
            if (s == editingStudent) {
                continue;
            }
            if (lastName.equalsIgnoreCase(safe(s.getLastName()))
                    && firstName.equalsIgnoreCase(safe(s.getFirstName()))) {
                return true;
            }
        }
        return false;
    }

    private void confirmDelete() {
        final Student target = editingStudent;
        if (target == null) {
            return;
        }
        SwingUtilities.invokeLater(new Runnable() {
            public void run() {
                // "Não" é a opção padrão (índice 0)
                Object[] options = { Messages.getString("LangVars.REG_NO"),
                        Messages.getString("LangVars.REG_YES") };
                int choice = JOptionPane.showInternalOptionDialog(RegistrationScreen.this.getParent(),
                                                                  Messages.getString("LangVars.REG_REALLYDELETE"),
                                                                  "",
                                                                  JOptionPane.DEFAULT_OPTION,
                                                                  JOptionPane.QUESTION_MESSAGE,
                                                                  null,
                                                                  options,
                                                                  options[0]);
                if (choice == 1) {
                    studentListData.remove(target);
                    saveStudents();
                    studentList.setListData(studentListData);
                    studentList.clearSelection();
                    showList();
                    if (!studentListData.isEmpty()) {
                        studentList.setSelectedIndex(0);
                    }
                }
            }
        });
    }

    private void saveStudents() {
        GameObject.getInstance()
                  .getDataFileHandler()
                  .saveAllStudentList(studentListData);
    }

