    /** Botão plano e arredondado; igual em qualquer Look & Feel. */
    private static class FlatButton extends JButton {
        private static final int ARC = 24;
        private final Color base;

        FlatButton(String text, Color bg, Color fg) {
            super(text);
            this.base = bg;
            setForeground(fg);
            setContentAreaFilled(false);
            setBorderPainted(false);
            setFocusPainted(false);
            setOpaque(false);
            setRolloverEnabled(true);
            setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        }

        @Override
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING,
                                RenderingHints.VALUE_ANTIALIAS_ON);
            Color fill;
            if (!isEnabled()) {
                fill = DISABLED_BG;
            } else if (getModel().isPressed()) {
                fill = base.darker();
            } else if (getModel().isRollover()) {
                fill = lighten(base, 25);
            } else {
                fill = base;
            }
            g2.setColor(fill);
            g2.fillRoundRect(0, 0, getWidth(), getHeight(), ARC, ARC);
            if (isFocusOwner()) { // contorno visível para quem usa o teclado
                g2.setColor(FOCUS);
                g2.setStroke(new BasicStroke(3f));
                g2.drawRoundRect(1, 1, getWidth() - 3, getHeight() - 3, ARC, ARC);
            }
            g2.dispose();
            super.paintComponent(g); // desenha o texto
        }
    }

    /** Linhas altas e com espaço, fáceis de tocar e de ler. */
    private class StudentCellRenderer extends DefaultListCellRenderer {
        @Override
        public Component getListCellRendererComponent(JList list, Object value,
                int index, boolean isSelected, boolean cellHasFocus) {
            String text = "";
            if (value instanceof Student) {
                Student s = (Student) value;
                text = s.getFirstName() + " " + s.getLastName();
            }
            JLabel c = (JLabel) super.getListCellRendererComponent(list, text,
                    index, isSelected, false);
            c.setFont(textFont);
            c.setForeground(TEXT);
            c.setBackground(isSelected ? SELECTION : CARD_BG);
            Border pad = scaledBorder(14, 18, 14, 18);
            if (isSelected) {
                // barra lateral: a seleção não depende só da cor
                c.setBorder(BorderFactory.createCompoundBorder(
                        BorderFactory.createMatteBorder(0, 8, 0, 0, FOCUS), pad));
                c.setFont(textFont.deriveFont(Font.BOLD));
            } else {
                c.setBorder(BorderFactory.createCompoundBorder(
                        BorderFactory.createMatteBorder(0, 0, 1, 0,
                                new Color(225, 225, 225)), pad));
            }
            return c;
        }
    }

    /** Renderer dos combos; opcionalmente traduz chaves via Messages. */
    private class ComboRenderer extends DefaultListCellRenderer {
        private final boolean translate;

        ComboRenderer(boolean translate) {
            this.translate = translate;
        }

        @Override
        public Component getListCellRendererComponent(JList list, Object value,
                int index, boolean isSelected, boolean cellHasFocus) {
            Object shown = value;
            if (translate && value instanceof String) {
                shown = Messages.getString((String) value);
            }
            JLabel c = (JLabel) super.getListCellRendererComponent(list, shown,
                    index, isSelected, cellHasFocus);
            c.setBorder(scaledBorder(6, 10, 6, 10));
            return c;
        }
    }
