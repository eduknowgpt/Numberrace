        JPanel side = new JPanel(new GridBagLayout());
        side.setBackground(CARD_BG);
        side.setBorder(BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(BORDER, 2),
                scaledBorder(25, 25, 25, 25)));
        side.setPreferredSize(new Dimension(scaled(340), 10));

        GridBagConstraints gc = new GridBagConstraints();
        gc.gridx = 0;
        gc.gridy = 0;
        gc.weightx = 1.0;
        gc.fill = GridBagConstraints.HORIZONTAL;
        gc.anchor = GridBagConstraints.NORTHWEST;
        gc.insets = translateInsets(new Insets(0, 0, 10, 0));
        side.add(infoNameLabel, gc);

        gc = new GridBagConstraints();
        gc.gridx = 0;
        gc.gridy = 1;
        gc.weightx = 1.0;
        gc.fill = GridBagConstraints.HORIZONTAL;
        gc.anchor = GridBagConstraints.NORTHWEST;
        side.add(sessionsPlayedLabel, gc);

        gc = new GridBagConstraints();
        gc.gridx = 0;
        gc.gridy = 2;
        gc.weightx = 1.0;
        gc.weighty = 1.0;
        gc.fill = GridBagConstraints.HORIZONTAL;
        gc.anchor = GridBagConstraints.NORTH;
        gc.ipady = scaled(20);
        gc.insets = translateInsets(new Insets(30, 0, 0, 0));
        side.add(startButton, gc);

        // barra inferior: Sair à esquerda, Novo/Modificar à direita
        JPanel rightButtons = transparentPanel(new FlowLayout(FlowLayout.RIGHT,
                scaled(15), 0));
        rightButtons.add(newStudentButton);
        rightButtons.add(modifyButton);

        JPanel bottom = transparentPanel(new BorderLayout());
        bottom.setBorder(scaledBorder(15, 0, 0, 0));
        bottom.add(quitButton, BorderLayout.WEST);
        bottom.add(rightButtons, BorderLayout.EAST);

        JPanel card = transparentPanel(new BorderLayout(gap, gap));
        card.add(studentListScrollPane, BorderLayout.CENTER);
        card.add(side, BorderLayout.EAST);
        card.add(bottom, BorderLayout.SOUTH);
        return card;
    }

