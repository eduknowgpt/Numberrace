    private Border fieldBorder(boolean error) {
        return BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(error ? ERROR : BORDER,
                                               error ? 3 : 2),
                scaledBorder(6, 10, 6, 10));
    }

    private Border scaledBorder(int top, int left, int bottom, int right) {
        Insets i = translateInsets(new Insets(top, left, bottom, right));
        return BorderFactory.createEmptyBorder(i.top, i.left, i.bottom, i.right);
    }

    private int scaled(int value) {
        return translateInsets(new Insets(value, value, value, value)).top;
    }

    private static String safe(String s) {
        return (s == null) ? "" : s.trim();
    }

    private static Color lighten(Color c, int amount) {
        return new Color(Math.min(255, c.getRed() + amount), Math.min(255,
                c.getGreen() + amount), Math.min(255, c.getBlue() + amount));
    }

