        addFormRow(box, 1, firstNameLabel, textFieldFirstName);
        addFormRow(box, 2, ageLabel, cbAge);
        addFormRow(box, 3, classLabel, textFieldClass);
        addFormRow(box, 4, sexLabel, cbGender);
        addFormRow(box, 5, startLevelLabel, cbStartLevel);

        GridBagConstraints gc = new GridBagConstraints();
        gc.gridx = 0;
        gc.gridy = 6;
        gc.gridwidth = 2;
        gc.fill = GridBagConstraints.HORIZONTAL;
        gc.insets = translateInsets(new Insets(10, 0, 10, 0));
        box.add(statusLabel, gc);

        // Excluir fica longe do Confirmar para evitar toques acidentais
        JPanel rightButtons = new JPanel(new FlowLayout(FlowLayout.RIGHT,
                scaled(15), 0));
        rightButtons.setBackground(CARD_BG);
        rightButtons.add(cancelButton);
        rightButtons.add(confirmButton);

        JPanel buttonBar = new JPanel(new BorderLayout());
        buttonBar.setBackground(CARD_BG);
        buttonBar.add(deleteButton, BorderLayout.WEST);
        buttonBar.add(rightButtons, BorderLayout.EAST);

        gc = new GridBagConstraints();
        gc.gridx = 0;
        gc.gridy = 7;
        gc.gridwidth = 2;
        gc.fill = GridBagConstraints.HORIZONTAL;
        gc.insets = translateInsets(new Insets(10, 0, 0, 0));
        box.add(buttonBar, gc);

        JPanel wrapper = transparentPanel(new GridBagLayout());
        wrapper.add(box, new GridBagConstraints()); // centraliza sem esticar
        return wrapper;
    }

    private void addFormRow(JPanel box, int row, JLabel label, JComponent field) {
        GridBagConstraints l = new GridBagConstraints();
        l.gridx = 0;
        l.gridy = row;
        l.anchor = GridBagConstraints.WEST;
        l.insets = translateInsets(new Insets(8, 0, 8, 25));
        box.add(label, l);

        GridBagConstraints f = new GridBagConstraints();
        f.gridx = 1;
        f.gridy = row;
        f.weightx = 1.0;
        f.fill = GridBagConstraints.HORIZONTAL;
        f.insets = translateInsets(new Insets(8, 0, 8, 0));
        box.add(field, f);
    }

    private void installKeyBindings() {
        // F1 / Help
        getInputMap(JComponent.WHEN_IN_FOCUSED_WINDOW).put(
                KeyStroke.getKeyStroke(KeyEvent.VK_HELP, 0, true), "showHelp");
        getActionMap().put("showHelp", getHelpAction());

        // Esc volta da tela de cadastro para a lista
        getInputMap(JComponent.WHEN_IN_FOCUSED_WINDOW).put(
                KeyStroke.getKeyStroke(KeyEvent.VK_ESCAPE, 0), "cancelForm");
        getActionMap().put("cancelForm", new AbstractAction() {
            public void actionPerformed(ActionEvent e) {
                if (formVisible) {
                    showList();
                }
            }
        });

        // Enter na lista inicia o jogo
        studentList.getInputMap(JComponent.WHEN_FOCUSED).put(
                KeyStroke.getKeyStroke(KeyEvent.VK_ENTER, 0), "startStudent");
        studentList.getActionMap().put("startStudent", new AbstractAction() {
            public void actionPerformed(ActionEvent e) {
                startSelected();
            }
        });
    }

