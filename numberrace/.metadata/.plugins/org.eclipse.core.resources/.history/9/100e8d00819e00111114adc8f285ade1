	public void stopAllSounds() {
		soundPlayer.stop();
	}

	public void close() {
		soundPlayer.shutdown();
	}

	/**
	 * Sets the paused state. Sounds may not pause immediately.
	 */
	public void setPaused(boolean paused) {
		if (paused) {
			soundPlayer.pause();
		} else {
			soundPlayer.unpause();
		}
	}

	/**
	 * Plays one of the game sounds
	 */
	public void play(String soundKey) {
		if (soundsON) {
			play(soundKey, null);
		}
	}

	public void play(String soundKey, SoundListener l) {
		if (soundsON) {
			try {
				play(soundKey, false, l);
			} catch (Exception e) {
				if (l != null)
					l.run();
			}
		} else if (l != null) {
			l.run();
		}
	}

	/**
	 * Plays one of the game sounds, with optional looping
	 */
	public void play(String soundKey, boolean loop) {
		if (soundsON) {
			play(soundKey, loop, null);
		}
	}

	private void play(String soundKey, boolean loop, SoundListener l) {
		//if translation feature is active, tell the screen to display a
		// translation

		//    	if (Debugger.IN_USE&&game.debugger.translation){
		//        	game.currentScreen.setLblTranslation(game.debugger.translator.getTranslation(soundKey));
		//        }

		//first figure out if the sound is stored in RAM or not
		//if yes, play from the Sound object stored in the commonSounds[] array

		final boolean isSoundID = soundID.get(soundKey) != null;
		if (log.isLoggable(Level.FINE)) {
			log.fine(String.format("[%s] soundID ? - %b ", soundKey, isSoundID));
		}

		if (isSoundID) {
			Integer tmpSoundID = soundID.get(soundKey); //get current sound value
			play(commonSounds[tmpSoundID.intValue()], loop, l);
		} else { //if not, stream from the file on disk, use SoundID map to get filename
			String fileName = soundMap.get(soundKey);
			log.info(String.format("Trying to play sound[%s] file: %s ",
					soundKey,
					String.valueOf(fileName)));
			if (fileName == null) {
				fileName = Resources.getString(String.format("SoundManager.%s",
						soundKey));
				if (fileName != null) {
					soundMap.put(soundKey, fileName);
				}
			}
			play(soundKey,
					getAudioInputStream(String.valueOf(fileName)),
					loop,
					l);
		}
	}

	public void play(Sound sound, boolean loop, SoundListener l) {
		if (sound != null) {
			play(sound.getKey(), getAudioInputStream(new ByteArrayInputStream(
					sound.getSamples())), loop, l);
		}
	}

	/**
	 * Plays a sound from an InputStream. This method returns immediately.
	 */
	protected void play(String soundKey,
			AudioInputStream is,
			boolean loop,
			SoundListener l) {

		if (is == null) {
			log.warning("Unable to play sound: " + soundKey);

			if (l != null) {
				l.run();
			}
			return;
		}

		soundPlayer.play(is, loop, l);
	}

	private void initializeGameSounds(String[] soundKeys) {
		//loads up the game sounds that are short and commonly used into Sound
		// objects,
		//which are stored in RAM. The rest of the sounds are streamed directly
		// from the file
		soundID = new HashMap<String, Integer>();
		for (int i = 0; i < soundKeys.length /* NUM_COMMON_SOUNDS */; i++) {
			//add to the id to the hashmap
			soundID.put(soundKeys[i], i);
			//put the sound in the Sound array
			String sndName = String.valueOf(soundMap.get(soundKeys[i]));
			commonSounds[i] = getSound(sndName);
			if (commonSounds[i] == null) {
				Utilities.log.severe("Putting null in commonSounds for "
						+ sndName);
			}
			//            System.out.println("SM IGS: put " + soundKeys[i] + "in the
			//             soundID list");
		}
	}

