	/**
	 * Loads a Sound from the file system. Returns null if an error occurs.
	 */
	private Sound getSound(String filename) {
		return getSound(filename,
				getAudioInputStream(ResourceProvider.getResourceAsStream(filename)));
	}

	/**
	 * Loads a Sound from an AudioInputStream.
	 * @param filename
	 */
	private Sound getSound(String fileName, AudioInputStream audioStream) {
		if (audioStream == null) {
			return null;
		}

		// get the number of bytes to read

		ByteArrayOutputStream samples = new ByteArrayOutputStream();

		// read the entire stream
		byte[] buffer = new byte[100 * 1024];

		try {
			while (true) {
				int read = audioStream.read(buffer, 0, buffer.length);
				if (read == -1) {
					break;
				}
				if (read > 0) {
					samples.write(buffer, 0, read);
				}
			}
		} catch (IOException e) {
			e.printStackTrace();
			return null;
		} finally {
		}

		// return the samples
		return new Sound(fileName, samples.toByteArray());
	}

	public int getSoundTime(String sound2Play) {
		if (cachedST.containsKey(sound2Play)) {
			return cachedST.get(sound2Play).intValue();
		}

		AudioInputStream audioInputStream = getAudioInputStream(soundMap.get(sound2Play));
		int time = 0;
		if (audioInputStream != null) {
			time = (int) (audioInputStream.getFrameLength() / (audioInputStream.getFormat()
					.getFrameRate() / 1000));
		} else {
			log.severe("NO AUDIO INPUT STREAM FOR :" + sound2Play);
		}
		if (log.isLoggable(Level.FINE)) {
			log.fine(sound2Play + " PlayTime : " + time);
		}
		cachedST.put(sound2Play, new Integer(time));
		return time;
	}

	/**
	 * Creates an AudioInputStream from a sound from the file system.
	 */
	public AudioInputStream getAudioInputStream(String filename) {

		if (filename == null || "null".equals(filename)) {
			log.warning("Audio filename is null.");
			return null;
		}

		InputStream resourceAsStream =
				ResourceProvider.getResourceAsStream(filename);

		if (resourceAsStream == null) {
			log.warning("Audio resource not found: " + filename);
			return null;
		}

		return getAudioInputStream(resourceAsStream);
	}

	/**
	 * Creates an AudioInputStream from a sound from an input stream
	 */
	private AudioInputStream getAudioInputStream(InputStream is) {
		if (is != null) {
			try {
				return AudioSystem.getAudioInputStream(is);
			} catch (UnsupportedAudioFileException ex) {
				ex.printStackTrace();
			} catch (IOException ex) {
				ex.printStackTrace();
			} catch (IllegalArgumentException ex) {
				ex.printStackTrace();
			}
		}
		return null;
	}

	public static SoundManager getInstance() {
		if (sm == null) {
			sm = new SoundManager();
		}
		return sm;
	}
